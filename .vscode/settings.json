{
  // ---- TypeScript: use the workspace TS version, richer inlay hints ----
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",

  // ---- ESLint (flat config) ----
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // No Prettier in this project; do not auto-format on save and fight the
  // existing code style. ESLint --fix is the only on-save code action.
  "editor.formatOnSave": false,

  // ---- Tailwind CSS IntelliSense ----
  // Teach Tailwind to read class strings inside cva() and cn() (this project
  // uses class-variance-authority and a cn() helper).
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "class:list"],
  "css.lint.unknownAtRules": "ignore",
  "editor.quickSuggestions": {
    "strings": "on"
  },

  // ---- Files: tidy the explorer and search ----
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/bun.lock": true,
    "**/package-lock.json": true,
    "**/*.docx": true,
    "**/*.xlsx": true,
    "**/*.mp4": true
  },

  // ---- Spell checker: brand and stack vocabulary ----
  "cSpell.words": [
    "Barnum",
    "cmdk",
    "cva",
    "embla",
    "famguides",
    "GHL",
    "Helmet",
    "jsdom",
    "Lovable",
    "lucide",
    "Mastermind",
    "Montserrat",
    "PromoEngine",
    "radix",
    "recharts",
    "shadcn",
    "tanstack",
    "Tempe",
    "vite",
    "vitest",
    "WEcosystem",
    "Wer"
  ]
}
